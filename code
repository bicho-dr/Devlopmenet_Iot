void handleRoot() {
  server.send(200, "text/html", MAIN_page);
}

// إرسال البيانات الحية بصيغة JSON لتقوم الصفحة بتحديث نفسها بدون إعادة تحميل
void handleData() {
  String json = "{";
  json += "\"temperature\":" + String(currentTemp, 1) + ",";
  json += "\"humidity\":" + String(currentHumidity, 1);
  json += "}";
  server.send(200, "application/json", json);
}

// دالة تحميل ملف الـ CSV إلى الهاتف
void handleDownloadCSV() {
  File file = SPIFFS.open("/sensor_log.csv", FILE_READ);
  if (!file) {
    server.send(404, "text/plain", "الملف غير موجود!");
    return;
  }
  server.streamFile(file, "text/csv");
  file.close();
}

void setup() {
  Serial.begin(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  dht.begin();
  initSPIFFS();

  // إعداد اللوحة لتكون شبكة واي فاي مستقلة (Access Point)
  Serial.println(F("جاري إنشاء شبكة الواي فاي..."));
  WiFi.softAP(ssid, password);
  
  IPAddress myIP = WiFi.softAPIP();
  Serial.print(F("عنوان الواي فاي (IP Address): "));
  Serial.println(myIP); // غالباً سيكون 192.168.4.1

  // مسارات سيرفر الويب
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/download-csv", handleDownloadCSV);
  
  server.begin();
  Serial.println(F("سيرفر الويب يعمل الآن بنجاح!"));
}

void loop() {
  server.handleClient(); // معالجة طلبات الهاتف المتصل بالسيرفر

  unsigned long currentMillis = millis();
  // قراءة الحساس وتخزين البيانات كل 5 ثوانٍ
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    float h = dht.readHumidity();
    float t = dht.readTemperature();

    if (!isnan(h) && !isnan(t)) {
      currentHumidity = h;
      currentTemp = t;

      // طباعة القراءات للتأكد في شاشة المراقبة
      Serial.print(F("حرارة: ")); Serial.print(t);
      Serial.print(F(" °C | رطوبة: ")); Serial.print(h); Serial.println(F("%"));

      // تخزين البيانات في ملف الـ CSV
      appendToCSV(t, h);

      // شرط التنبيه (البازر)
      if (t >= TEMP_THRESHOLD) {
        digitalWrite(BUZZER_PIN, HIGH);
      } else {
        digitalWrite(BUZZER_PIN, LOW);
      }
    } else {
      Serial.println(F("فشل قراءة الحساس!"));
    }
  }
}