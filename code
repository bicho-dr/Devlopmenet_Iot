#include <WiFi.h>
#include <WebServer.h>
#include <SPIFFS.h>
#include "DHT.h"

// إعدادات الواي فاي (اللوحة ستعمل كنقطة اتصال Access Point ليتصل بها هاتفك مباشرة)
const char* ssid = "ESP32_S3_Monitor";
const char* password = "12345678"; // كلمة المرور (يجب ألا تقل عن 8 أرقام)

// تعريف الأطراف
#define DHTPIN 20        
#define DHTTYPE DHT11    
#define BUZZER_PIN 40    

const float TEMP_THRESHOLD = 30.0;

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

// متغيرات لتخزين آخر قراءات
float currentTemp = 0.0;
float currentHumidity = 0.0;
unsigned long previousMillis = 0;
const long interval = 5000; // قراءة وحفظ كل 5 ثوانٍ

// دالة لتهيئة نظام الملفات للتخزين بصيغة CSV
void initSPIFFS() {
  if (!SPIFFS.begin(true)) {
    Serial.println(F("فشل في تهيئة الـ SPIFFS!"));
    return;
  }
  Serial.println(F("تم تهيئة الـ SPIFFS بنجاح."));

  // إذا لم يكن ملف الـ CSV موجوداً، نقوم بإنشائه مع كتابة العناوين في أول سطر
  if (!SPIFFS.exists("/sensor_log.csv")) {
    File file = SPIFFS.open("/sensor_log.csv", FILE_WRITE);
    if (file) {
      file.println("Time_ms,Temperature_C,Humidity_Percent");
      file.close();
      Serial.println(F("تم إنشاء ملف الـ CSV الجديد."));
    }
  }
}

// دالة لحفظ القراءات في ملف CSV داخل الذاكرة الداخلية
void appendToCSV(float temp, float hum) {
  File file = SPIFFS.open("/sensor_log.csv", FILE_APPEND);
  if (!file) {
    Serial.println(F("خطأ في فتح ملف الـ CSV للتسجيل!"));
    return;
  }
  file.print(millis());
  file.print(",");
  file.print(temp);
  file.print(",");
  file.println(hum);
  file.close();
  Serial.println(F("تم تسجيل القراءة في ملف الـ CSV."));
}

// تصميم صفحة الويب التي ستظهر على هاتفك
